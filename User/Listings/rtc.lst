   11          /**
   12          * @brief RTC初始化：启动32.768K时钟源、写入初始时间、启动RTC走时
   13          * @note 初始时间在这里改，第一次上电会按这个时间开始走
   14          */
   15          void RTC_Init(void)
   16          {
   17   1              X32KCR = 0xc0;                          //启动外部 32K 晶振
   18   1              while(!(X32KCR & 0x01));        //等待时钟稳定
   19   1              RTCCFG &= ~0X02;                        //选择外部 32K 作为 RTC 时钟源
   20   1              
   21   1              //写入初始时间：手动授时。可以升级成网络授时、卫星授时（GPS/北斗），涉及通信协议。
   22   1              INIYEAR   = 0;                          // 年
   23   1          INIMONTH  = 0;                              // 月            
   24   1          INIDAY    = 0;                              // 日             
   25   1          INIHOUR   = 19;                             // 时            
   26   1          INIMIN    = 25;                     // 分          
   27   1          INISEC    = 10;                     // 秒          
   28   1          INISSEC   = 0;                      // 1/128s           
   29   1              
   30   1              RTCIF = 0x00;                           //清除RTC中断标志
   31   1              RTCIEN = 0x00;                          //关闭RTC所有中断
   32   1              
   33   1              //启动RTC并装载初始值
   34   1              RTCCR = 0x01;                           //RTC开始计数
   35   1              RTCCFG |= 0x01;                         //把INI寄存器的值装进计数器
   36   1              while(RTCCFG & 0x01);           //等硬件装载完成（会自动清零）
   37   1      }
   38          
   39          /**
   40          * @brief 读RTC的时、分、秒
   41          * @note 主循环里每秒调用一次
   42          */
   43          void RTC_ReadTime(void)
   44          {
   45   1              hour = RTCHOUR;                         //读时
   46   1              minute = RTCMIN;                        //读分
   47   1          second = RTCSEC;                    //读秒
   48   1      }


