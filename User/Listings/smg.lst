   60          //数码管扫描,显示“00-00-00”
   61          void SMG_Scan(void)
   62          {
   63   1              uint8_t segdat; //用于存放段码数据
   64   1              uint8_t bitdat; //用于存放位选码数据
   65   1              
   66   1              //消隐
   67   1              HC595_SendByte(0x00);   //段码清零
   68   1              HC595_SendByte(0xff);   //位码清零
   69   1              HC595_Latch();                  //锁存输出，全灭
   70   1              
   71   1              // 根据当前的扫描下标，查表得到段码、位选码
   72   1              segdat = Code_Seg[smg_buf[scan_idx]];
   73   1              bitdat =~ Code_Bit[scan_idx];   //共阴极
   74   1              
   75   1              //根据原理图，要先发送段码
   76   1              HC595_SendByte(segdat); //先发送段码
   77   1              HC595_SendByte(bitdat); //再发送位选
   78   1              HC595_Latch();                  //锁存输出，点亮当前位
   79   1              
   80   1              // 轮换到下一位，为下一次调用做准备
   81   1              scan_idx++;
   82   1              if(scan_idx >= SMG_NUM) 
   83   1              {
   84   2                      scan_idx = 0;
   85   2              }
   86   1      }
